# ─────────────────────────────────────────────────────────────
#  backend/.env.example  —  copy to backend/.env and edit.
#  Used for: LOCAL DEV (no Docker)
# ─────────────────────────────────────────────────────────────

# ── SERVER ────────────────────────────────────────────────────
PORT=8001
NODE_ENV=production
# odin = full system, shiftplanner = standalone Dienstplaner without crawler/writeback/assignment.
APP_MODE=shiftplanner

# ── DATABASE ──────────────────────────────────────────────────
# Option 1 (preferred): single connection URL
# DATABASE_URL=postgresql://shiftplanner_app:your_password@postgres:5432/shiftplanner

# Option 2: individual vars (used when DATABASE_URL is not set)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=shiftplanner
DB_USER=shiftplanner_app
DB_PASSWORD=SET_TO_POSTGRES_PASSWORD

# ── AUTH ──────────────────────────────────────────────────────
# REQUIRED in production (app exits if missing).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret
JWT_EXPIRES_IN=8h

# ── SECURITY ──────────────────────────────────────────────────
# REQUIRED in production (app exits if missing).
SHIFTPLANNER_API_KEY=SET_TO_A_SHARED_32_PLUS_CHAR_KEY

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated for multiple origins: "https://a.com,https://b.com"
CORS_ORIGINS=

# ── SMTP (Feedback-E-Mail) ────────────────────────────────────
# REQUIRED for feedback email sending. Without SMTP_HOST, emails are disabled.
# SMTP_HOST=smtp.your-company.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=odin-feedback@eu.equinix.com

# Public HTTPS address of the web app. Required for CoC review links sent by email.
# COC_PUBLIC_URL=https://shiftplanner.your-company.example
# COC_REVIEW_TOKEN_TTL=14d

# ── VITE DEV PROXY ────────────────────────────────────────────
# Read by vite.config.ts in the frontend — points dev proxy at backend.
# Change to http://backend:5055 when running inside Docker.
BACKEND_URL=http://127.0.0.1:5055

# Optional: Set this to directly point the Vite frontend to the backend URL without proxy in production
# Example: VITE_API_BASE_URL=http://localhost:8001
VITE_API_BASE_URL=
# Optional frontend mode for local standalone Dienstplaner work.
VITE_APP_MODE=odin
