# Copy this file to .env before the first production start.
POSTGRES_DB=shiftplanner
POSTGRES_USER=shiftplanner_app
POSTGRES_PASSWORD=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
DB_HOST=postgres
DB_PORT=5432
DB_NAME=shiftplanner
DB_USER=shiftplanner_app
DB_PASSWORD=REPLACE_WITH_THE_EXACT_POSTGRES_PASSWORD
JWT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
SHIFTPLANNER_API_KEY=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
SHIFTPLANNER_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
JWT_EXPIRES_IN=8h

FRONTEND_PORT=8080
BACKEND_PORT=8001
HTTPS_PORT=8443
HTTP_PORT=8081
# DNS name resolving to the VM. Use this HTTPS URL in the Chrome extension.
ODIN_HOSTNAME=odin-go.example.internal
CORS_ORIGINS=

# Weather uses the request IP when a public client IP reaches the VM.
# These coordinates are used for local/VPN/private addresses or if IP lookup is unavailable.
WEATHER_FALLBACK_LAT=50.1109
WEATHER_FALLBACK_LON=8.6821
WEATHER_FALLBACK_NAME=Frankfurt am Main

# Optional integrations used by shift-planning communication.
TEAMS_CHANNEL_WEBHOOK=
TEAMS_PERSONAL_WEBHOOK=

# CoC external review links and email notifications.
# This must be the HTTPS URL through which managers can reach the frontend.
COC_PUBLIC_URL=https://shiftplanner.your-company.example
COC_REVIEW_TOKEN_TTL=14d
SMTP_HOST=smtp.your-company.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=coc@your-company.example
