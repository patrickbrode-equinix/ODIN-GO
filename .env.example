# Copy this file to .env before the first production start.
POSTGRES_DB=shiftplanner
POSTGRES_USER=shiftplanner_app
POSTGRES_PASSWORD=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
DB_HOST=postgres
DB_PORT=5432
DB_NAME=shiftplanner
DB_USER=shiftplanner_app
DB_PASSWORD=REPLACE_WITH_THE_EXACT_POSTGRES_PASSWORD
JWT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
SHIFTPLANNER_API_KEY=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
SHIFTPLANNER_ADMIN_PASSWORD=root
# Emergency reset: set true for one redeploy, sign in with the configured
# password, then immediately set this back to false and redeploy once more.
SHIFTPLANNER_RESET_ADMIN_PASSWORD=false

# Nginx Proxy Manager forwards HTTPS to the frontend on host port 8080.
# The backend is reachable only inside the Docker network.
CORS_ORIGINS=https://jarvis-emea.equinix.com,https://eqx-portal.corp.equinix.com

# Weather uses the request IP when a public client IP reaches the VM.
# These coordinates are used for local/VPN/private addresses or if IP lookup is unavailable.
WEATHER_FALLBACK_LAT=50.1109
WEATHER_FALLBACK_LON=8.6821
WEATHER_FALLBACK_NAME=Frankfurt am Main

# Web SSO with authentik (OpenID Connect). Leave empty to keep password-only login.
# In authentik: create an OAuth2/OpenID provider + application, client type "Confidential",
# redirect URI (strict): https://jarvis-emea.equinix.com/api/auth/sso/callback
# Scopes: openid, profile, email. Only members of AUTHENTIK_ADMIN_GROUP (or users that are
# admin in ODIN GO's user table) may enter the web UI.
AUTHENTIK_ISSUER_URL=https://authentik.example.com/application/o/odin-go/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_PUBLIC_URL=https://jarvis-emea.equinix.com
AUTHENTIK_ADMIN_GROUP=odin-go-admins
